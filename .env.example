# Set these variables in the server process. No secret is committed.
DASHSCOPE_API_KEY=
# Optional, default is <repository>/backend/data
# ZHIXING_DATA=

# Optional real external search. Set in the server process.
TAVILY_API_KEY=
# Local models default to backend/data/models.
# ZHIXING_MODEL_DIR=
# ZHIXING_WHISPER_MODEL=

# tavily or dashscope. dashscope uses DASHSCOPE_API_KEY and the Beijing endpoint.
ZHIXING_SEARCH_PROVIDER=tavily
ZHIXING_SEARCH_MODEL=qwen-plus
# Pre-pull this image after Docker is installed.
ZHIXING_CODE_IMAGE=python:3.12-slim

# OpenAI GPT API, used by the OpenAI model configuration.
OPENAI_API_KEY=

# DeepSeek official API
DEEPSEEK_API_KEY=

# Project HTTPS SMS gateway adapter; see phone-security-setup.md
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
